{
  "$schema": "https://github.com/imohuan/unifyai/blob/main/schemas/mcp-config.schema.json",
  "mcpServers": {
    "filesystem": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/path/to/your/directory"
      ]
    },
    "remote-example": {
      "type": "remote",
      "enabled": true,
      "url": "https://your-mcp-gateway.example.com/path",
      "headers": {
        "Authorization": "Bearer YOUR_API_KEY_HERE"
      }
    },
    "codegraph": {
      "type": "local",
      "enabled": false,
      "command": [
        "codegraph",
        "serve",
        "--mcp",
        "--path",
        "${workspaceFolder}"
      ]
    }
  }
}
